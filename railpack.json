{
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  },
  "healthcheck": {
    "http": {
      "path": "/",
      "port": 3000,
      "timeoutSeconds": 15,
      "intervalSeconds": 10,
      "threshold": 3
    }
  }
}
