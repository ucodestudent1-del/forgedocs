# Demo environment configuration - Premium tier simulation
# This environment simulates the Pro/Business premium experience
# with strategic restrictions to encourage conversion to paid tiers

# Supabase (demo environment)
NEXT_PUBLIC_SUPABASE_URL=https://demo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon-key
SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key

# Stripe (demo/test mode)
STRIPE_SECRET_KEY=sk_test_demo
STRIPE_WEBHOOK_SECRET=whsec_demo
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_demo

# App
NEXT_PUBLIC_APP_URL=https://demo.forgedocs.com
NEXT_PUBLIC_DEMO_MODE=true

# Demo tier simulation - All users default to Pro tier with demo limits
NEXT_PUBLIC_DEMO_DEFAULT_TIER=pro
NEXT_PUBLIC_DEMO_MAX_DOCUMENTS=100
NEXT_PUBLIC_DEMO_MAX_CONVERSIONS=50
NEXT_PUBLIC_DEMO_MAX_STORAGE_GB=10
NEXT_PUBLIC_DEMO_MAX_API_REQUESTS_PER_MIN=30
NEXT_PUBLIC_DEMO_MAX_FILE_SIZE_MB=10

# Demo feature restrictions (encourage conversion)
NEXT_PUBLIC_DEMO_HAS_PRIORITY_SUPPORT=false
NEXT_PUBLIC_DEMO_HAS_AUDIT_LOGS=false
NEXT_PUBLIC_DEMO_HAS_ADVANCED_TEMPLATES=false
NEXT_PUBLIC_DEMO_HAS_SSO=false
NEXT_PUBLIC_DEMO_HAS_CUSTOM_INTEGRATIONS=false
NEXT_PUBLIC_DEMO_HAS_SLA_GUARANTEE=false
NEXT_PUBLIC_DEMO_MAX_SEATS=3

# Email (demo)
RESEND_API_KEY=demo-resend-key
EMAIL_FROM=ForgeDocs Demo <noreply@demo.forgedocs.com>

# Redis (demo)
REDIS_URL=redis://demo-redis:6379

# Sentry (demo)
SENTRY_DSN=
SENTRY_ORG=demo-org
SENTRY_PROJECT=demo-project

# MFA (demo)
MFA_SECRET_ENCRYPTION_KEY=demo-mfa-encryption-key-do-not-use-in-production
