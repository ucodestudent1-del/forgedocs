# Build-time environment variables.
# Only NEXT_PUBLIC_* variables are safe at build time.
# Secret keys must be provided at runtime via environment variables.

# NOTE: NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY must be
# real values (not placeholders) for authentication to work. These are baked
# into the client bundle at build time, so placeholder credentials will cause
# sign-in to fail in production. Get real values from Supabase Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable guest mode during build so dashboard layout doesn't redirect
# and RSC manifests can be generated for all dashboard routes.
NEXT_PUBLIC_GUEST_MODE=true
GUEST_USER_ID=00000000-0000-0000-0000-000000000000

# When true, the Supabase client factory returns a mock client during build
# instead of attempting to connect to Supabase. Set to false only when real
# Supabase credentials are available at build time.
NEXT_PUBLIC_BUILD_MOCK=true
