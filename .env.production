# =============================================================================
# ForgeDocs — Production Environment Variables for Railway
# =============================================================================
# Copy this file to .env.production and fill in all required values.
# On Railway, set these in the Railway dashboard (Variables tab).
# Never commit real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (REQUIRED)
# Get these from your Supabase project dashboard > Settings > API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Stripe (REQUIRED for billing)
# Get these from your Stripe dashboard > Developers > API keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# -----------------------------------------------------------------------------
# App (REQUIRED)
# Set NEXT_PUBLIC_APP_URL to your Railway deployment URL
# (e.g., https://forgedocs-production.up.railway.app)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# -----------------------------------------------------------------------------
# CDN / Asset Prefix (OPTIONAL — for CDN-backed static asset delivery)
# Set to your CDN URL (e.g., https://cdn.yourdomain.com) to serve JS/CSS/images from a CDN
# Leave blank to serve assets from your application server
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ASSET_PREFIX=

# -----------------------------------------------------------------------------
# Email / Resend (REQUIRED for auth emails)
# Get API key from Resend dashboard. Verify your domain first.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ForgeDocs <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Redis (REQUIRED for caching, rate limiting, tier limits, worker queue)
# On Railway, add the Redis service and use the provided RAILWAY_REDIS_URL
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:your-redis-password@your-redis-host.railway.app:6379

# -----------------------------------------------------------------------------
# Sentry (OPTIONAL — error monitoring)
# Get these from Sentry dashboard > Settings > Project > API Keys
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# -----------------------------------------------------------------------------
# MFA / TOTP (REQUIRED — encrypts mfa_secret at rest)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never rotate this without re-encrypting all stored mfa_secret values.
# -----------------------------------------------------------------------------
MFA_SECRET_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# -----------------------------------------------------------------------------
# Document encryption (REQUIRED for encrypted documents)
# Encrypts per-document content encryption keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never rotate this without re-encrypting all stored encrypted documents.
# -----------------------------------------------------------------------------
DOCUMENT_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# -----------------------------------------------------------------------------
# Google OAuth (OPTIONAL — social login)
# Get these from Google Cloud Console > Credentials
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Demo mode (OPTIONAL — set to "true" to simulate tier restrictions)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_DEFAULT_TIER=pro
NEXT_PUBLIC_DEMO_MAX_DOCUMENTS=100
NEXT_PUBLIC_DEMO_MAX_CONVERSIONS=50
NEXT_PUBLIC_DEMO_MAX_STORAGE_GB=10
NEXT_PUBLIC_DEMO_MAX_API_REQUESTS_PER_MIN=30
NEXT_PUBLIC_DEMO_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_DEMO_HAS_PRIORITY_SUPPORT=false
NEXT_PUBLIC_DEMO_HAS_AUDIT_LOGS=false
NEXT_PUBLIC_DEMO_HAS_ADVANCED_TEMPLATES=false
NEXT_PUBLIC_DEMO_MAX_SEATS=3

# -----------------------------------------------------------------------------
# Free-tier guest mode (OPTIONAL — set to "true" to disable login page)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GUEST_MODE=false
GUEST_USER_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Worker Health (REQUIRED for async document conversion worker)
# Set to your worker service URL (e.g., https://worker-your-app.up.railway.app/api/health)
# -----------------------------------------------------------------------------
WORKER_HEALTH_URL=

# -----------------------------------------------------------------------------
# Log Aggregation (OPTIONAL — centralized logging)
# Set LOG_ENDPOINT to forward logs to Datadog, Logtail, CloudWatch, etc.
# Example: https://logs.datadoghq.com/api/v2/logs
# -----------------------------------------------------------------------------
LOG_ENDPOINT=

# -----------------------------------------------------------------------------
# Build-time (REQUIRED for Docker builds on Railway)
# Only NEXT_PUBLIC_* variables are safe at build time.
# Secret keys must be provided at runtime via Railway variables.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BUILD_MOCK=false

# =============================================================================
# End of environment variables
# =============================================================================
