{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node_modules/.bin/next start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 10000,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

# Note: The BullMQ conversion worker must be deployed as a separate Railway service
# using the same Dockerfile with startCommand: "npm run worker". It requires Redis
# and the same runtime environment variables as the app service.