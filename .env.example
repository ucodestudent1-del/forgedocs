# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CDN / Asset Prefix (optional — for CDN-backed static asset delivery)
# Set to your CDN URL (e.g., https://cdn.yourdomain.com) to serve static assets from a CDN
NEXT_PUBLIC_ASSET_PREFIX=

# Sentry
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Demo environment (optional - for demo mode simulation)
# Set NEXT_PUBLIC_DEMO_MODE=true to enable demo tier restrictions
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_DEFAULT_TIER=pro
NEXT_PUBLIC_DEMO_MAX_DOCUMENTS=100
NEXT_PUBLIC_DEMO_MAX_CONVERSIONS=50
NEXT_PUBLIC_DEMO_MAX_STORAGE_GB=10
NEXT_PUBLIC_DEMO_MAX_API_REQUESTS_PER_MIN=30
NEXT_PUBLIC_DEMO_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_DEMO_HAS_PRIORITY_SUPPORT=false
NEXT_PUBLIC_DEMO_HAS_AUDIT_LOGS=false
NEXT_PUBLIC_DEMO_HAS_ADVANCED_TEMPLATES=false
NEXT_PUBLIC_DEMO_MAX_SEATS=3

# Free-tier guest mode (optional)
# Set NEXT_PUBLIC_GUEST_MODE=true to disable login and allow anonymous access
NEXT_PUBLIC_GUEST_MODE=false
GUEST_USER_ID=00000000-0000-0000-0000-000000000000
